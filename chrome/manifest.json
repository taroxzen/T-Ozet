{
  "manifest_version": 3,
  "name": "T-Özet",
  "version": "1.0.0",
  "author": "Taroxzen",
  "description": "Haberleri ve forumları Gemini ile küçük popup penceresinde akıllı modlar ve yapısal format seçenekleriyle özetleyen hızlı araç. Geliştirici: Taroxzen.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "T-Özet (Taroxzen)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/options.html",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "t-ozet@taroxzen.local",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://gemini.google.com/*"],
      "js": ["content/readability.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content/gemini-autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}